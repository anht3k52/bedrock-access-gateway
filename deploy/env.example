# Copy to deploy/.env.local (DO NOT commit). Load via run-gateway.ps1 / start.bat.
#
# --- Admin login (preferred: salted SHA-256, NEVER plaintext in production) ---
ADMIN_USERNAME=mrdev
ADMIN_PASSWORD_SALT=change-me-random-salt
# PowerShell: python -c "import hashlib; print(hashlib.sha256(b'SALT:PASSWORD').hexdigest())"
ADMIN_PASSWORD_SHA256=replace-with-sha256-hex
# ADMIN_PASSWORD=only-for-local-tests
ADMIN_SESSION_HOURS=12
# Keep false so PM2 restart does not force admin re-login
ADMIN_REVOKE_SESSIONS_ON_STARTUP=false
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

ADMIN_API_KEY=change-me-to-a-long-random-admin-secret

# Secret admin UI path: https://api.example/#/<slug>  (change after leak; old link dies)
ADMIN_UI_SLUG=ops-x9k2m7q4
# Optional: only these IPs can call /admin API (comma-separated; empty = all IPs + password)
# ADMIN_IP_ALLOWLIST=1.2.3.4,2405:4803:

# Legacy shared key — keep false on public proxy (forces bag_... keys)
ENABLE_LEGACY_API_KEY=false
# API_KEY=

DEFAULT_RPM_LIMIT=60
DEFAULT_MONTHLY_TOKEN_QUOTA=2000000

HOST=127.0.0.1
PORT=8000
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
# On Throttling / "too many tokens per day": rotate regional endpoints + us./eu./global. profiles.
# Keep the region list short — each failed try adds ~0.5–2s before first token.
BEDROCK_FAILOVER_REGIONS=us-west-2,us-east-1,us-east-2
BEDROCK_RUNTIME_MAX_ATTEMPTS=1
BEDROCK_FAILOVER_MAX_TRIES=6

DISABLE_OPENAPI=true
ENABLE_PROMPT_CACHING=true
ALLOWED_ORIGINS=https://api.mrdev.cyou,http://127.0.0.1:8000

# AUTH_DB_PATH=C:\Users\YOU\.bedrock-access-gateway\auth.db
# Optional process-wide fallback (also: Admin → AWS tab can store multiple keys + model routing).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
